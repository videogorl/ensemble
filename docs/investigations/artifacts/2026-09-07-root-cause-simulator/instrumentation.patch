+#if DEBUG
+import ObjectiveC
+
+// Temporary experiment instrumentation; removed before handoff.
+private enum NetworkAuditSession {
+    static func install() {
+        guard ProcessInfo.processInfo.environment["ENSEMBLE_AUDIT_PROXY_PORT"] != nil,
+              let original = class_getClassMethod(URLSessionConfiguration.self, #selector(getter: URLSessionConfiguration.default)),
+              let replacement = class_getClassMethod(URLSessionConfiguration.self, #selector(URLSessionConfiguration.auditDefault)) else { return }
+        method_exchangeImplementations(original, replacement)
+    }
+
+    @MainActor static var prepared = false
+
+    @MainActor static func prepare() async {
+        guard let mode = ProcessInfo.processInfo.environment["ENSEMBLE_AUDIT_MODE"] else { return }
+        guard !prepared else { return }
+        prepared = true
+        try? await Task.sleep(nanoseconds: 15_000_000_000)
+        let deps = DependencyContainer.shared
+        if mode != "normal" {
+            deps.syncCoordinator.stopPeriodicSync()
+            deps.webSocketCoordinator.stop()
+            await deps.offlineDownloadService.pauseQueue()
+            await deps.offlineDownloadService.suspendSidecarAnalysis()
+            deps.foregroundWorkScheduler.setForegroundActive(false)
+        }
+        if mode == "mutations" {
+            await mutationExperiment(deps)
+            return
+        }
+        AppLogger.info("NETWORK_AUDIT prepared mode=\(mode)")
+        guard let source = ProcessInfo.processInfo.environment["ENSEMBLE_AUDIT_SOURCE"],
+              let stored = try? await deps.libraryRepository.fetchTrack(ratingKey: "13827", sourceCompositeKey: source) else { return }
+        let track = Track(from: stored)
+        try? await Task.sleep(nanoseconds: 2_000_000_000)
+        AppLogger.info("NETWORK_AUDIT begin mode=\(mode)")
+        if mode == "normal" || mode == "sync" {
+            Task { await deps.syncCoordinator.syncAllIncremental() }
+        }
+        if mode == "probes" {
+            Task {
+                for _ in 0..<8 {
+                    await deps.serverHealthChecker.invalidateConnectionHealth()
+                    await deps.serverHealthChecker.checkAllServers()
+                    try? await Task.sleep(nanoseconds: 3_000_000_000)
+                }
+            }
+        }
+        if mode == "normal" || mode == "download" {
+            await deps.offlineDownloadService.resumeQueue()
+            if let storedAlbum = try? await deps.libraryRepository.fetchAlbum(ratingKey: "12935", sourceCompositeKey: source) {
+                Task { await deps.offlineDownloadService.setAlbumDownloadEnabled(Album(from: storedAlbum), isEnabled: true) }
+            }
+        }
+        await deps.playbackService.play(tracks: [track], startingAt: 0)
+        for _ in 0..<45 {
+            try? await Task.sleep(nanoseconds: 1_000_000_000)
+            AppLogger.info("NETWORK_AUDIT position seconds=\(deps.playbackService.currentTime)")
+        }
+        deps.playbackService.pause()
+        await deps.offlineDownloadService.pauseQueue()
+        AppLogger.info("NETWORK_AUDIT end mode=\(mode)")
+    }
+    @MainActor static func mutationExperiment(_ deps: DependencyContainer) async {
+        guard let source = ProcessInfo.processInfo.environment["ENSEMBLE_AUDIT_SOURCE"] else { return }
+        let repository = PendingMutationRepository(coreDataStack: deps.coreDataStack)
+        func snapshot(_ phase: String) async {
+            let rows = (try? await repository.fetchAllMutationRecords()) ?? []
+            AppLogger.info("NETWORK_AUDIT mutations phase=\(phase) rows=\(rows.count) pending=\(deps.mutationCoordinator.pendingCount)")
+            for row in rows {
+                AppLogger.info("NETWORK_AUDIT mutation id=\(row.id) status=\(row.status) retries=\(row.retryCount)")
+            }
+        }
+        do {
+            deps.networkMonitor.simulateOffline(true)
+            try await Task.sleep(nanoseconds: 300_000_000)
+            for key in ["900000001", "900000002"] {
+                let track = Track(id: key, key: "/library/metadata/" + key, title: "Network audit", sourceCompositeKey: source)
+                _ = try await deps.mutationCoordinator.rateTrack(track, rating: 10)
+            }
+            await snapshot("offline-enqueued")
+            deps.networkMonitor.simulateOffline(false)
+            for pass in 1...3 {
+                for _ in 0..<120 {
+                    await deps.mutationCoordinator.drainQueue()
+                    let rows = try await repository.fetchAllMutationRecords()
+                    if rows.contains(where: { $0.retryCount >= pass }) { break }
+                    try await Task.sleep(nanoseconds: 500_000_000)
+                }
+                await snapshot("failed-pass-\(pass)")
+            }
+            NetworkAuditMutationProtocol.restore()
+            await deps.mutationCoordinator.drainQueue()
+            await snapshot("transport-restored")
+            for row in try await repository.fetchAllMutationRecords() {
+                try await repository.resetToRetry(id: row.id)
+            }
+            await deps.mutationCoordinator.drainQueue()
+            await snapshot("explicit-retry")
+        } catch {
+            AppLogger.error("NETWORK_AUDIT mutation experiment error=\(error)")
+        }
+        AppLogger.info("NETWORK_AUDIT end mode=mutations")
+    }
+
+}
+
+extension URLSessionConfiguration {
+    @objc fileprivate class func auditDefault() -> URLSessionConfiguration {
+        let config = auditDefault()
+        if ProcessInfo.processInfo.environment["ENSEMBLE_AUDIT_MODE"] == "mutations" {
+            config.protocolClasses = [NetworkAuditMutationProtocol.self] + (config.protocolClasses ?? [])
+        }
+        if let value = ProcessInfo.processInfo.environment["ENSEMBLE_AUDIT_PROXY_PORT"], let port = Int(value) {
+            config.connectionProxyDictionary = [
+                "HTTPEnable": 1, "HTTPProxy": "127.0.0.1", "HTTPPort": port,
+                "HTTPSEnable": 1, "HTTPSProxy": "127.0.0.1", "HTTPSPort": port
+            ]
+        }
+        return config
+    }
+}
+#endif
+
+#if DEBUG
+// Intercepts only fabricated audit rating keys; no audit mutation reaches PMS.
+private final class NetworkAuditMutationProtocol: URLProtocol {
+    private static let lock = NSLock()
+    private static var restored = false
+    static func restore() { lock.lock(); restored = true; lock.unlock() }
+    override class func canInit(with request: URLRequest) -> Bool {
+        guard let url = request.url, url.path == "/:/rate" else { return false }
+        return URLComponents(url: url, resolvingAgainstBaseURL: false)?.queryItems?.contains {
+            $0.name == "key" && ["900000001", "900000002"].contains($0.value ?? "")
+        } == true
+    }
+    override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+    override func startLoading() {
+        guard let url = request.url else { return }
+        let key = URLComponents(url: url, resolvingAgainstBaseURL: false)?.queryItems?.first { $0.name == "key" }?.value
+        Self.lock.lock(); let allowed = Self.restored || key == "900000001"; Self.lock.unlock()
+        AppLogger.info("NETWORK_AUDIT mockRating key=\(key ?? "none") acknowledged=\(allowed)")
+        if allowed {
+            client?.urlProtocol(self, didReceive: HTTPURLResponse(url: url, statusCode: 200, httpVersion: nil, headerFields: nil)!, cacheStoragePolicy: .notAllowed)
+            client?.urlProtocolDidFinishLoading(self)
+        } else {
+            client?.urlProtocol(self, didFailWithError: URLError(.networkConnectionLost))
+        }
+    }
+    override func stopLoading() {}
+}
+#endif
